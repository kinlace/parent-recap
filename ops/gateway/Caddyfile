# Only inference and sending the Brief are public. Bifrost's admin API and UI stay on 127.0.0.1
# (ssh -L). No access log: request lines are not worth keeping.
{$GATEWAY_HOST} {
	handle /v1/messages {
		rewrite * /anthropic/v1/messages
		reverse_proxy 127.0.0.1:8080
	}
	handle /v1/brief {
		reverse_proxy 127.0.0.1:8081
	}
	# The Brief's List-Unsubscribe page: how a Household stops the Brief.
	handle /brief/stop {
		root * /usr/local/share/brief-relay
		rewrite * /stop.html
		file_server
	}
	handle {
		respond "Not found" 404
	}
}
