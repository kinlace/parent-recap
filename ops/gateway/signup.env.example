# Copy to /etc/parent-recap-signup/signup.env (root, mode 0600). gateway-setup.sh writes it.
# Neither is secret: Bifrost's admin login comes from bifrost.env.
# The unpacked release whose install.sh installs the program for each Household.
SIGNUP_RELEASE=
# The gateway's hostname, which each Invite Link starts with (invite.sh).
GATEWAY_HOST=
