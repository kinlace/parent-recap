class Refused(Exception):
    """A deploy refused before it changed anything."""


def _system(argv: list[str], capture: bool = False,
            env: dict[str, str] | None = None) -> subprocess.CompletedProcess:
    # From /, as _exec: a Household's or the service's user can't read a maintainer's folder.
    return subprocess.run(argv, capture_output=capture, text=True, cwd="/",
                          env={**_clean_env(), **(env or {})})


def _github(url: str) -> Any:
    """GitHub's public API, without a login: the server holds no GitHub credentials."""
    request = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json",
                                                   "User-Agent": "parent-recap-admin"})
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.loads(response.read())


def _http_status(url: str) -> int:
    try:
        with urllib.request.urlopen(url, timeout=15) as response:
            return response.status
    except urllib.error.HTTPError as e:
        return e.code
    except OSError:
        return 0


def _uid(name: str) -> int | None:
    import pwd  # here, not at the top: Windows, where the tests also run, has none
    try:
        return pwd.getpwnam(name).pw_uid
    except KeyError:
        return None


@dataclass
class Edge:
    """What `deploy` reaches outside this process, so a test can fake it: commands (git aside,
    which runs on the repo for real), GitHub's API, an address's HTTP status, the clock and the
    server's users."""
    system: Callable[..., subprocess.CompletedProcess] = _system
    github: Callable[[str], Any] = _github
    http_status: Callable[[str], int] = _http_status
    now: Callable[[], datetime] = lambda: datetime.now(UTC)
    monotonic: Callable[[], float] = time.monotonic
    sleep: Callable[[float], None] = time.sleep
    free: Callable[[Path], int] = lambda path: shutil.disk_usage(path).free
    ask: Callable[[str], str] = input
    # The uid of the user of this name, None if there is none.
    uid: Callable[[str], int | None] = _uid


def _deploy(paths: Paths, args: list[str], edge: Edge) -> int:
    anyway = "--anyway" in args
    refs = [a for a in args if a != "--anyway"]
    if len(refs) != 1 or refs[0].startswith("-"):
        raise Usage(DEPLOY_USAGE)
    try:
        host = _env(paths.signup_env).get("GATEWAY_HOST")
        if not host:
            raise Refused(f"GATEWAY_HOST is missing from {paths.signup_env}: the server's first "
                          "install is gateway-setup.sh's (README \"Building the server\")")
        commit, tag = _resolve(paths, refs[0])
        short = commit[:SHORT]
        if tag is None:
            _test_passed(paths, commit, edge)
        households = _households(paths)
        check = _check_household(paths, households)
        _evening_is_quiet(paths, households, edge, anyway)
        snapshot = _snapshot(paths, short, edge)
        source = _checkout(paths, commit)
    except Refused as e:
        print(f"not deployed, nothing changed: {e}", file=sys.stderr)
        return 1

    print(f"deploying {short} ({tag or 'unreleased, a commit on main'}) from {source}",
          flush=True)
    setup = edge.system(["bash", str(source / "ops" / "gateway" / "gateway-setup.sh")],
                        env={"GATEWAY_HOST": host, "PARENT_RECAP_RELEASE": str(source),
                             "PARENT_RECAP_DEPLOY": short})
    deployed = {"commit": commit, "tag": tag or "unreleased", "at": _stamp(edge),
                "snapshot": snapshot.name}
    if setup.returncode != 0:
        # It may have installed part of the commit, so it is recorded, as failed: `rollback`
        # then puts the deploy before back whole, whether `current` moved or not.
        _record(paths, {**deployed, "failed": True})
        print(f"❌ gateway-setup.sh of {short} failed (above), so this deploy is recorded as "
              f"failed. {_running_deploy(paths)}. To put the deploy before back whole: sudo "
              "admin rollback", file=sys.stderr)
        return 1
    _record(paths, deployed)
    print(f"recorded: {_running_deploy(paths)}", flush=True)

    ok = _healthy(host, edge)
    ok = (_evening_run(paths, check, edge) if check else _no_check()) and ok
    if not ok:
        print(f"\n❌ {short} is deployed but a check failed (above): switch back with sudo admin "
              "rollback, as README \"Upgrade, check, switch back\" says", file=sys.stderr)
        return 1
    print(f"\n✅ {short} is deployed and checked")
    return 0


def _git(paths: Paths, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", f"--git-dir={paths.repo}", *args], capture_output=True,
                          text=True, env={**os.environ, "GIT_TERMINAL_PROMPT": "0"})


def _why_not(r: subprocess.CompletedProcess) -> str:
    return (r.stderr.strip().splitlines() or [f"exit {r.returncode}"])[-1]


def _resolve(paths: Paths, ref: str) -> tuple[str, str | None]:
    """The commit `ref` names and the release tag on it, if any: a release tag, main, or a
    commit on main by its hash. The repo is fetched first, its main and its tags only, so a
    commit only on another branch is unknown here."""
    if not (ref == "main" or RELEASE_TAG.fullmatch(ref) or COMMIT.fullmatch(ref)):
        raise Refused(f"{ref} is neither a release tag (vX.Y.Z), main nor a commit's hash: "
                      "nothing else is deployed")
    _fetch(paths)
    if RELEASE_TAG.fullmatch(ref):
        commit = _rev(paths, f"refs/tags/{ref}")
        if not commit:
            raise Refused(f"the repo has no tag {ref}")
        return commit, ref
    commit = _rev(paths, "refs/heads/main" if ref == "main" else ref)
    if not commit:
        raise Refused(f"no commit on main is {ref}")
    if ref != "main" and _git(paths, "merge-base", "--is-ancestor", commit,
                              "refs/heads/main").returncode != 0:
        raise Refused(f"{ref} is no commit on main: only main's commits and release tags are "
                      "deployed")
    tags = [t for t in _git(paths, "tag", "--points-at", commit).stdout.split()
            if RELEASE_TAG.fullmatch(t)]
    return commit, max(tags, key=lambda t: tuple(map(int, RELEASE_TAG.fullmatch(t).groups())),
                       default=None)


def _fetch(paths: Paths) -> None:
    if shutil.which("git") is None:
        raise Refused("git isn't installed: sudo apt-get install git")
    if not (paths.repo / "HEAD").exists():
        paths.repo.parent.mkdir(parents=True, exist_ok=True)
        init = subprocess.run(["git", "init", "--quiet", "--bare", str(paths.repo)],
                              capture_output=True, text=True)
        if init.returncode != 0:
            raise Refused(f"couldn't make {paths.repo}: {_why_not(init)}")
    fetched = _git(paths, "fetch", "--quiet", "--prune", "--no-auto-gc", paths.repo_url,
                   "+refs/heads/main:refs/heads/main", "+refs/tags/*:refs/tags/*")
    if fetched.returncode != 0:
        raise Refused(f"couldn't fetch {paths.repo_url}: {_why_not(fetched)}")


def _rev(paths: Paths, name: str) -> str | None:
    r = _git(paths, "rev-parse", "--verify", "--quiet", f"{name}^{{commit}}")
    return r.stdout.strip() if r.returncode == 0 else None


RUNNING = "still running"


def _test_passed(paths: Paths, commit: str, edge: Edge) -> None:
    """An unreleased commit's `test` check passed on GitHub, or, while its own is missing or
    still running, that of the head of the PR it came from, with the same code (#818); a release
    tag's ran before it was published (release.yml)."""
    short = commit[:SHORT]
    ends = _test_ends(paths, commit, edge)
    if ends and ends <= set(PASSED):
        return
    if ends - set(PASSED) - {RUNNING}:
        # A failure on main is never overridden by a PR's pass.
        raise Refused(f"{short}'s test check on GitHub is {', '.join(sorted(ends))}: an "
                      "unreleased commit is deployed only once it passed")
    tested, why_not = _same_code_tested(paths, commit, edge)
    if tested:
        head, number = tested
        print(f"✅ {short} has the same code as {head[:SHORT]}, whose test check passed (the "
              f"head of PR #{number})", flush=True)
        return
    own = (f"{short} has no test check on GitHub yet" if not ends
           else f"{short}'s test check on GitHub is still running")
    raise Refused(f"{own}{'; ' + why_not if why_not else ''}: an unreleased commit is deployed "
                  "only once its test check passed, or that of its PR's head with the same code")


def _ask_github(url: str, about: str, edge: Edge) -> Any:
    try:
        return edge.github(url)
    except (OSError, ValueError) as e:
        raise Refused(f"couldn't ask GitHub {about}: {e}") from e


def _test_ends(paths: Paths, commit: str, edge: Edge) -> set[str]:
    """How each of `commit`'s latest `test` check runs ended, RUNNING for one that hasn't."""
    answer = _ask_github(
        f"{paths.github_api}/commits/{commit}/check-runs?check_name=test&filter=latest",
        f"whether {commit[:SHORT]}'s test check passed", edge)
    runs = answer.get("check_runs") if isinstance(answer, dict) else ()
    if not isinstance(runs, list) and runs is not None:
        raise Refused(f"couldn't ask GitHub whether {commit[:SHORT]}'s test check passed: it "
                      "answered something else")
    return {r.get("conclusion") or RUNNING for r in runs or []
            if isinstance(r, dict) and r.get("name") == "test"}


def _same_code_tested(paths: Paths, commit: str,
                      edge: Edge) -> tuple[tuple[str, int] | None, str]:
    """The head, and its PR's number, of a PR into main that `commit` came from, whose `test`
    check passed on `commit`'s code; else None and why none, empty if no such PR is known.

    A PR's `test` doesn't run on its head: actions/checkout on pull_request checks out GitHub's
    merge of the head into main as main was when the run started (GITHUB_SHA, the last merge
    commit on refs/pull/N/merge, GitHub's "Events that trigger workflows"). That merge
    has the head's own tree when main as it was then is an ancestor of the head: merging in an
    ancestor changes nothing. main only moves forward (rebase merges, no force push, and the
    PR's own merge moves it later still), so main as it was then is an ancestor of main as it was
    when the PR landed. So it is enough that the head was built on that: then it was tested as it
    is. A rebase merge puts the head's commits since its merge base with `commit` on top of main
    one for one, ending at `commit`, so the head was built on main as it was when the PR landed
    when it is as many commits past that merge base as `commit` is; if it was built on an older
    main, `commit` is past it by main's commits since then too. (A rebase that dropped a head's
    commit already on main could make up the count; the trees must be equal all the same, so the
    merge tested added only what the head already made.) The trees being equal then makes the
    tested code `commit`'s."""
    short = commit[:SHORT]
    tree = _git(paths, "rev-parse", f"{commit}^{{tree}}").stdout.strip()
    about = f"which PR {short} came from"
    pulls = _ask_github(f"{paths.github_api}/commits/{commit}/pulls", about, edge)
    if not isinstance(pulls, list):
        raise Refused(f"couldn't ask GitHub {about}: it answered something else")
    reasons = []
    for pr in pulls:
        try:
            number, base, head = int(pr["number"]), pr["base"]["ref"], str(pr["head"]["sha"])
        except (TypeError, KeyError, ValueError) as e:
            raise Refused(f"couldn't ask GitHub {about}: it answered something else") from e
        if base != "main" or not COMMIT.fullmatch(head):
            continue
        hshort = head[:SHORT]
        try:
            head_tree = _ask_github(f"{paths.github_api}/git/commits/{head}",
                                    f"what code {hshort} has", edge)["tree"]["sha"]
            compared = _ask_github(f"{paths.github_api}/compare/{commit}...{head}",
                                   f"what {hshort} was built on", edge)
            ahead, behind = int(compared["ahead_by"]), int(compared["behind_by"])
        except (TypeError, KeyError, ValueError) as e:
            raise Refused(f"couldn't ask GitHub about PR #{number}'s head {hshort}: it answered "
                          "something else") from e
        if head_tree != tree:
            reasons.append(f"PR #{number}'s head {hshort} has other code")
            continue
        if ahead != behind:
            reasons.append(f"PR #{number}'s head {hshort} has the same code but was built on an "
                           "older main, so its test check ran on other code")
            continue
        ends = _test_ends(paths, head, edge)
        if ends and ends <= set(PASSED):
            return (head, number), ""
        reasons.append(f"PR #{number}'s head {hshort} has the same code, and its test check "
                       f"{'is ' + ', '.join(sorted(ends)) if ends else 'is missing'}")
    return None, "; ".join(reasons)


def _households(paths: Paths) -> list[tuple[str, str]]:
    """Each Household's label and evening time from the sign-up's households.json."""
    path = paths.store / "households.json"
    if not path.exists():
        return []
    try:
        listed = json.loads(path.read_text(encoding="utf-8"))
        return [(str(h["user"]), str(h["evening"])) for h in listed
                if LABEL.fullmatch(str(h["user"]))]
    except (OSError, ValueError, TypeError, KeyError) as e:
        raise Refused(f"couldn't read {path}: {e}") from e


def _check_household(paths: Paths, households: list[tuple[str, str]]) -> str | None:
    """The Household whose evening run checks each deploy: CHECK_HOUSEHOLD in deploy.env, set
    once on the server. A server without Households yet needs none."""
    if not households:
        return None
    label = _env(paths.deploy_env).get("CHECK_HOUSEHOLD", "").strip()
    how = (f"name the Household whose evening run checks each deploy, once: "
           f"sudo mkdir -p {paths.deploy_env.parent} && "
           f"echo CHECK_HOUSEHOLD=ph-… | sudo tee {paths.deploy_env}")
    if not label:
        raise Refused(how)
    if label not in {user for user, _ in households}:
        raise Refused(f"CHECK_HOUSEHOLD {label} is no Household's: {how}")
    return label


def _evening_is_quiet(paths: Paths, households: list[tuple[str, str]], edge: Edge,
                      anyway: bool) -> None:
    """No evening run is still running or due within SOON, and `admin households` marks no
    Household. --anyway deploys regardless of a run due and of the marks, such as the fix for
    what it marks, but never under a running run: `current` would change beneath it."""
    if not households:
        return
    _none_running(households, edge, "Deploy")
    now = edge.now()
    due = [f"{user}'s evening run is due at {evening}" + ("" if zone == ZONE else f" {zone}")
           for user, evening, zone in _evenings(paths, households)
           if _due_soon(evening, now.astimezone(ZoneInfo(zone)))]
    if anyway:
        if due:
            print("⚠️ deploying anyway, though " + "; ".join(due), flush=True)
        return
    if due:
        raise Refused("; ".join(due) + ". Deploy once the evening runs are over, or give "
                      "--anyway")
    print("every Household's status first (sudo admin households):", flush=True)
    if edge.system(_as_service(paths, [], "signup", "status")).returncode != 0:
        raise Refused("admin households marks a Household (above). To deploy the fix for that, "
                      "give --anyway")


def _none_running(households: list[tuple[str, str]], edge: Edge, what: str) -> None:
    running = [f"{user}'s evening run is still running" for user, _ in households
               if any(_unit(edge, user, job).get("ActiveState") in ("active", "activating")
                      for job in JOBS)]
    if running:
        raise Refused("; ".join(running) + f". {what} once it has ended")


def _evenings(paths: Paths, households: list[tuple[str, str]]) -> list[tuple[str, str, str]]:
    """Each Household's label, evening time and timezone: its config's, which its timer follows,
    as `admin households` shows them (#780). Where its config won't load, or the shared program
    can't read it, households.json's slot, in Helsinki."""
    configs = {c.parent.parent.name: c for c in _configs(paths)}
    wanted = [str(configs[user]) for user, _ in households if user in configs]
    read: Any = {}
    if wanted:
        try:
            done = subprocess.run([paths.python, "-I", "-c", READ_EVENINGS, *wanted],
                                  capture_output=True, text=True, cwd="/", timeout=60)
            read = json.loads(done.stdout)
        except (OSError, subprocess.TimeoutExpired, ValueError):
            print(f"⚠️ couldn't read the Households' own evening times with {paths.python}, so "
                  "households.json's are used", flush=True)
    if not isinstance(read, dict):
        read = {}
    evenings = []
    for user, slot in households:
        own = read.get(str(configs[user])) if user in configs else None
        if (isinstance(own, list) and len(own) == 2 and isinstance(own[0], str)
                and EVENING.fullmatch(own[0]) and _zone(own[1])):
            evenings.append((user, own[0], own[1]))
        else:
            evenings.append((user, slot, ZONE))
    return evenings


def _zone(name: Any) -> bool:
    """Whether `name` is a timezone this host knows."""
    try:
        ZoneInfo(name)
    except (KeyError, TypeError, ValueError, OSError):  # ZoneInfoNotFoundError is a KeyError
        return False
    return True


def _due_soon(evening: str, now: datetime) -> bool:
    try:
        hour, minute = map(int, evening.split(":"))
        due = now.replace(hour=hour, minute=minute, second=0, microsecond=0)
    except ValueError:
        return True  # a time it can't read might be any
    return (due - now) % timedelta(days=1) <= SOON


def _unit(edge: Edge, user: str, unit: str) -> dict[str, str]:
    """A Household's systemd user unit's properties, read as root through its user manager."""
    r = edge.system(["systemctl", "--user", "-M", f"{user}@", "show", "--property=ActiveState,"
                     "Result,ExecMainStatus,ExecMainStartTimestampMonotonic", unit], capture=True)
    return dict(line.split("=", 1) for line in (r.stdout or "").splitlines() if "=" in line)


def _rmtree(path: Path) -> None:
    """Removes a checkout, if there is one, read-only files included: git makes its objects
    read-only, which Windows, where the tests run too, won't delete as they are."""
    def writable(func: Callable, name: str, _: Any) -> None:
        os.chmod(name, stat.S_IWRITE)
        func(name)
    if not (path.exists() or path.is_symlink()):
        return
    if sys.version_info >= (3, 12):
        shutil.rmtree(path, onexc=writable)
    else:
        shutil.rmtree(path, onerror=writable)


def _checkout(paths: Paths, commit: str) -> Path:
    """The commit's whole tree, ops/ included, in its own folder: the release zip leaves ops/ out
    (.gitattributes), so this is a checkout, not an archive."""
    source = paths.sources / commit[:SHORT]
    incoming = paths.sources / f"{commit[:SHORT]}.incoming"
    paths.sources.mkdir(parents=True, exist_ok=True)
    _rmtree(incoming)
    steps =(["git", "clone", "--quiet", "--no-checkout", str(paths.repo), str(incoming)],
             ["git", "-C", str(incoming), "-c", "advice.detachedHead=false", "checkout",
              "--quiet", "--detach", commit])
    for step in steps:
        r = subprocess.run(step, capture_output=True, text=True)
        if r.returncode != 0:
            _rmtree(incoming)
            raise Refused(f"couldn't check out {commit[:SHORT]}: {_why_not(r)}")
    # The same commit deployed again: its old checkout goes only once the new one is whole.
    _rmtree(source)
    incoming.rename(source)
    return source


def _deploys(paths: Paths) -> list[dict]:
    try:
        listed = json.loads(paths.record.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    return [d for d in listed if isinstance(d, dict)] if isinstance(listed, list) else []


def _record(paths: Paths, deploy: dict) -> None:
    paths.record.parent.mkdir(parents=True, exist_ok=True)
    incoming = paths.record.with_suffix(".incoming")
    incoming.write_text(json.dumps([*_deploys(paths), deploy], indent=1) + "\n",
                        encoding="utf-8")
    os.replace(incoming, paths.record)


def _current(paths: Paths) -> str | None:
    """The folder name the shared program's `current` points at, if it is installed."""
    try:
        return os.readlink(paths.shared / "current")
    except OSError:
        return None


def _stamp(edge: Edge) -> str:
    return edge.now().astimezone(UTC).isoformat(timespec="seconds")


def _when(deploy: dict) -> str:
    """How a record's entry came to run, and when."""
    how = ("switched back to" if deploy.get("rolled_back_from") else
           "deployed, its install failed," if deploy.get("failed") else "deployed")
    return f"{how} {deploy.get('at')}"


def _running_deploy(paths: Paths) -> str:
    """Which deploy the shared program's `current` is, by its record."""
    name = _current(paths)
    if name is None:
        return "the shared program isn't installed"
    mine = [d for d in _deploys(paths) if str(d.get("commit", ""))[:SHORT] == name]
    if not mine:
        return f"the server runs {name}, which isn't recorded: it was deployed by hand"
    last = mine[-1]
    what = ("unreleased, a commit on main, until a release tag is deployed"
            if last.get("tag") == "unreleased" else last.get("tag"))
    return f"the server runs {last.get('commit')} ({what}), {_when(last)}"


# ── Snapshots (#744)

KEEP_SNAPSHOTS = 3
# Room a deploy needs beyond its snapshot: the program it installs, with its own Python and Node.
ROOM = 1 << 30
SNAPSHOT_NAME = re.compile(r"\d{8}T\d{6}Z-[0-9a-f]{12}\.tar\.gz")
MANIFEST = "snapshot.json"


def _state_roots(paths: Paths) -> list[Path]:
    """What a snapshot holds: the services' state and config, and each Household's home. A
    Household's home is taken as it is, links and all; root follows none of them."""
    homes = sorted(p for p in paths.homes.glob("ph-*") if LABEL.fullmatch(p.name)
                   and not p.is_symlink() and p.is_dir()) if paths.homes.is_dir() else []
    return [p for p in paths.state if p.is_dir() and not p.is_symlink()] + homes


def _entries(root: Path):
    """Each folder, file and link under `root`, root first, without following a link."""
    yield root
    for folder, dirs, files in os.walk(root):
        for name in sorted(dirs) + sorted(files):
            yield Path(folder) / name


def _snapshot(paths: Paths, short: str, edge: Edge) -> Path:
    """Archives the server's state before deploy `short` changes anything, readable by root
    alone, and keeps the last KEEP_SNAPSHOTS and the one the deploy that runs was made after.
    Refuses when there isn't room for it and for the deploy, or it couldn't be written whole.
    The services are stopped while their own state is archived, so a database isn't caught
    mid-write; the Households' homes are taken after, with no evening run running."""
    roots = _state_roots(paths)
    services = len([r for r in roots if r in paths.state])
    size = 0
    for root in roots:
        for entry in _entries(root):
            try:
                size += entry.lstat().st_size if entry.is_file() and not entry.is_symlink() else 0
            except OSError:
                pass  # gone since it was listed
    try:
        paths.snapshots.mkdir(parents=True, exist_ok=True)
        os.chmod(paths.snapshots, 0o700)
        free = edge.free(paths.snapshots)
    except OSError as e:
        raise Refused(f"couldn't make {paths.snapshots} for the snapshot: {e}") from e
    if free < size + ROOM:
        raise Refused(f"there isn't room for the snapshot of the server's state ({_mb(size)}) and "
                      f"the deploy ({_mb(ROOM)}): {_mb(free)} free in {paths.snapshots}. Remove an "
                      "old snapshot there, or a deploy that isn't current (README \"Upgrade, "
                      "check, switch back\")")
    stamp = edge.now().astimezone(UTC).strftime("%Y%m%dT%H%M%SZ")
    archive = paths.snapshots / f"{stamp}-{short}.tar.gz"
    incoming = archive.with_name(archive.name + ".incoming")
    print(f"snapshot of the server's state ({_mb(size)} before compression), with "
          + ", ".join(SERVICES) + f" stopped meanwhile: {archive}", flush=True)
    stopped = False
    try:
        _stop_services(edge)
        stopped = True
        # Text mode would turn the archive's newlines into CRLF where there is one (Windows).
        fd = os.open(incoming, os.O_WRONLY | os.O_CREAT | os.O_TRUNC
                     | getattr(os, "O_BINARY", 0), 0o600)
        with os.fdopen(fd, "wb") as out, \
                tarfile.open(fileobj=out, mode="w:gz", compresslevel=6) as tar:
            manifest = json.dumps({"roots": [str(r) for r in roots], "before": short}).encode()
            info = tarfile.TarInfo(MANIFEST)
            info.size, info.mode = len(manifest), 0o600
            tar.addfile(info, io.BytesIO(manifest))
            for i, root in enumerate(roots):
                if i == services and stopped:
                    _start_services(edge)
                    stopped = False
                for entry in _entries(root):
                    name = "/".join([str(i), *entry.relative_to(root).parts])
                    try:
                        tar.add(entry, arcname=name, recursive=False)
                    except FileNotFoundError:
                        pass  # gone since it was listed
        os.replace(incoming, archive)
    except (OSError, tarfile.TarError) as e:
        incoming.unlink(missing_ok=True)
        raise Refused(f"the snapshot of the server's state failed: {e}") from e
    finally:
        if stopped:
            _start_services(edge)
    top = _stack(paths)[-1:]
    keep = {str(d.get("snapshot")) for d in top}
    for old in _snapshots(paths)[:-KEEP_SNAPSHOTS]:
        if old.name not in keep:
            old.unlink(missing_ok=True)
    return archive


def _stop_services(edge: Edge) -> bool:
    """Stops the gateway's services; False, saying why, when systemctl couldn't stop one. It
    stops the others still, and a service not installed yet, such as the sign-up service before
    the first release, is one it can't."""
    r = edge.system(["systemctl", "stop", *SERVICES], capture=True)
    if r.returncode != 0:
        print(f"⚠️ systemctl stop said: {_why_not(r)}", flush=True)
    return r.returncode == 0


def _start_services(edge: Edge) -> None:
    r = edge.system(["systemctl", "start", *SERVICES], capture=True)
    if r.returncode != 0:
        print(f"⚠️ couldn't start every one of {', '.join(SERVICES)} again: {_why_not(r)}",
              file=sys.stderr, flush=True)


def _snapshots(paths: Paths) -> list[Path]:
    """The snapshots on disk, oldest first: their names start with their time."""
    if not paths.snapshots.is_dir():
        return []
    return sorted((p for p in paths.snapshots.iterdir() if SNAPSHOT_NAME.fullmatch(p.name)),
                  key=lambda p: p.name)


def _mb(size: int) -> str:
    return f"{size / (1 << 20):.0f} MB"


def _inside(member: tarfile.TarInfo, dest: str) -> tarfile.TarInfo:
    """Every name stays inside the folder it is unpacked in, as tarfile's "tar" filter has it,
    while owners, modes and links stay as they were: that filter would clear some modes."""
    tarfile.tar_filter(member, dest)
    return member


def _restore(archive: Path,
             why_not: Callable[[Path, tarfile.TarInfo | None], str | None] = lambda *_: None
             ) -> tuple[list[Path], list[tuple[Path, str]]]:
    """Puts back each folder `archive` holds, whole: it is unpacked beside the folder first,
    which is swapped for it only once that is complete. A folder `why_not` gives a reason for,
    given the folder and its own entry in the archive, is left as it is. Returns the folders put
    back and those left, each with its reason."""
    put_back, left = [], []
    with tarfile.open(archive, "r:gz") as tar:
        manifest = json.loads(tar.extractfile(MANIFEST).read())
        members = tar.getmembers()
        for i, root in enumerate(map(Path, manifest["roots"])):
            mine = [m for m in members if m.name == str(i) or m.name.startswith(f"{i}/")]
            top = next((m for m in mine if m.name == str(i)), None)
            reason = why_not(root, top)
            if reason:
                left.append((root, reason))
                continue
            staging = root.with_name(f".{root.name}.restoring")
            aside = root.with_name(f".{root.name}.before-restore")
            # A restore stopped between setting the folder aside and swapping in its copy left
            # the folder only there.
            if aside.exists() and not (root.exists() or root.is_symlink()):
                aside.rename(root)
            for leftover in (staging, aside):
                shutil.rmtree(leftover, ignore_errors=True)
            staging.mkdir(mode=0o700, parents=True)
            try:
                tar.extractall(staging, members=mine, numeric_owner=True, filter=_inside)
                if root.exists() or root.is_symlink():
                    root.rename(aside)
                (staging / str(i)).rename(root)
            except BaseException:
                if aside.exists() and not root.exists():
                    aside.rename(root)
                raise
            finally:
                shutil.rmtree(staging, ignore_errors=True)
            shutil.rmtree(aside, ignore_errors=True)
            put_back.append(root)
    return put_back, left


def _home_kept_out(paths: Paths,
                   edge: Edge) -> Callable[[Path, tarfile.TarInfo | None], str | None]:
    """Why a Household's home in a snapshot isn't put back: unpacked with the uid it was owned
    by, it would be readable by whoever holds that uid now. So it is put back only while its
    user still exists and holds that uid; a removed Household's home stays out."""
    def why_not(root: Path, top: tarfile.TarInfo | None) -> str | None:
        if root.parent != paths.homes or not LABEL.fullmatch(root.name):
            return None
        if top is None:
            return "the snapshot doesn't say who owned it"
        uid = edge.uid(root.name)
        if uid is None:
            return "its user no longer exists, so the Household was removed since"
        if uid != top.uid:
            return ("its user no longer holds the uid it was owned by, which another user may "
                    "hold now")
        return None
    return why_not


