class Usage(Exception):
    """A task given the wrong arguments: exits 2 with the usage line."""


def main(argv: list[str], paths: Paths | None = None,
         is_root: Callable[[], bool] = lambda: os.geteuid() == 0,
         exec_as: Callable[[list[str], dict], int] | None = None,
         fetch: Callable[..., dict] | None = None, today: str | None = None,
         edge: Edge | None = None,
         run: Callable[[list[str], dict], tuple[int, str]] | None = None,
         smtp: Callable[..., Any] | None = None,
         ask: Callable[[str], str] | None = None) -> int:
    paths = paths or Paths()
    exec_as = exec_as or _exec
    if not is_root():
        print("admin needs root: it reads the gateway's admin login and runs the program as the "
              "sign-up service's user. Run it as: sudo admin <task>", file=sys.stderr)
        return 1
    task, args = (argv[0], argv[1:]) if argv else ("--help", [])
    try:
        if task in ("--help", "-h", "help"):
            print(USAGE)
            return 0
        if task == "invite":
            host = _env(paths.signup_env).get("GATEWAY_HOST")
            if not host:
                sys.exit(f"GATEWAY_HOST is missing from {paths.signup_env}: run gateway-setup.sh")
            return exec_as(_as_service(paths, [], "signup", "invite", "--url",
                                       f"https://{host}", *args), _clean_env())
        if task == "households":
            print(_running_deploy(paths), flush=True)
            return exec_as(_as_service(paths, [], "signup", "status", *args), _clean_env())
        if task == "household":
            return _household(paths, args, exec_as)
        if task == "deploy":
            return _deploy(paths, args, edge or Edge())
        if task == "deploys":
            if args:
                raise Usage("deploys")
            return _list_deploys(paths)
        if task == "rollback":
            return _rollback(paths, args, edge or Edge())
        if task == "remove":
            if len(args) != 1:
                raise Usage("remove ph-XXXXXXXX")
            login = _admin_login(paths)
            return exec_as(_as_service(paths, [f"--preserve-env={','.join(ADMIN_LOGIN)}"],
                                       "signup", "remove", args[0]), {**_clean_env(), **login})
        if task == "keys":
            if args not in ([], ["--addresses"]):
                raise Usage("keys [--addresses]")
            relay, keys = _keys(paths, fetch)
            relay.print_keys(keys, paths.relay_state, today=today or _today(),
                             addresses=args == ["--addresses"])
            return 0
        if task == "cost":
            if args:
                raise Usage("cost")
            relay, keys = _keys(paths, fetch)
            relay.print_cost(keys, today=today or _today())
            return 0
        if task == "key":
            return _key(paths, args, fetch, today, ask)
        if task == "find":
            if len(args) != 1 or not args[0].strip():
                raise Usage("find TEXT")
            return _find(paths, args[0], fetch, run or _run, today or _today())
        if task == "check":
            if args not in ([], ["--mail"]):
                raise Usage("check [--mail]")
            return _check(paths, run or _run, mail=bool(args), smtp=smtp,
                          today=today or _today())
        if task == "signed-up":
            if len(args) != 1 or not LABEL.fullmatch(args[0]):
                raise Usage("signed-up ph-XXXXXXXX")
            return _signed_up(paths, args[0], smtp)
    except Usage as e:
        print(f"usage: sudo admin {e}", file=sys.stderr)
        return 2
    print(f"admin: no task {task}\n\n{USAGE}", file=sys.stderr)
    return 2


def _key(paths: Paths, args: list[str], fetch: Callable[..., dict] | None,
         today: str | None, ask: Callable[[str], str] | None) -> int:
    verb, rest = (args[0], args[1:]) if args else ("", [])
    if verb == "new":
        relay, keys = _keys(paths, fetch)
        relay.new_key(keys, rest, today=today or _today(), ask=ask)
        return 0
    if verb in ("off", "on"):
        if len(rest) != 1:
            raise Usage(f"key {verb} NAME-OR-ID")
        relay, keys = _keys(paths, fetch)
        relay.switch_key(keys, rest[0], on=verb == "on")
        return 0
    raise Usage('key new LABEL "WHO HOLDS IT" [--send-only] | key off NAME-OR-ID | '
                "key on NAME-OR-ID")


HOUSEHOLD_USAGE = "household ph-XXXXXXXX [recipients|myclub]"
# What `admin household LABEL [CHANGE]` runs as the Household: show reads only (#782).
HOUSEHOLD_TASKS = {None: "show", "recipients": "recipients", "myclub": "myclub"}


def _household(paths: Paths, args: list[str], exec_as: Callable[[list[str], dict], int]) -> int:
    """Runs `signup show`, `signup recipients` or `signup myclub` as the Household's own user, on
    this terminal (#782). Root runs it straight, not through the sign-up service's user, whom
    signup.sudoers lets read none of a Household's MyClub links. What is typed, the addresses
    and links, goes to the program's stdin, never on its command line, which sudo logs."""
    if not 1 <= len(args) <= 2 or (args[1:] and args[1] not in HOUSEHOLD_TASKS):
        raise Usage(HOUSEHOLD_USAGE)
    label = args[0]
    try:
        households = {user for user, _ in _households(paths)} if LABEL.fullmatch(label) else set()
    except Refused as e:
        print(f"admin household: {e}", file=sys.stderr)
        return 1
    if label not in households:
        print(f"{label} is no Hosted Household's label: sudo admin households lists them",
              file=sys.stderr)
        return 1
    command = HOUSEHOLD_TASKS[args[1] if args[1:] else None]
    return exec_as(["sudo", "-u", label, "-H", "--", paths.program, "signup", command],
                   _clean_env())


def _find(paths: Paths, text: str, fetch: Callable[..., dict] | None,
          run: Callable[[list[str], dict], tuple[int, str]], today: str) -> int:
    """Each Household with `text` among its Recipients, then each Gateway Key holding it in its
    description or its bound addresses (#758), with a Hosted Household's key followed by that
    Household's status. 1 only when nothing matched. One half that can't be searched says why
    and doesn't stop the other."""
    households = _searched("no Household searched", lambda: _find_households(paths, text))
    keys = _searched("no Gateway Key searched", lambda: _find_keys(paths, text, fetch, run, today))
    if households or keys:
        return 0
    print(f"nothing matched {text}: no Household has it among its Recipients, and no Gateway "
          "Key in who holds it or its addresses", file=sys.stderr)
    return 1


def _searched(failed: str, search: Callable[[], int]) -> int:
    """How many `search` found; 0, saying why, when it exited."""
    try:
        return search()
    except SystemExit as e:
        if e.code not in (None, 0):
            print(f"{failed}: {e.code}", file=sys.stderr)
        return 0


def _find_keys(paths: Paths, text: str, fetch: Callable[..., dict] | None,
               run: Callable[[list[str], dict], tuple[int, str]], today: str) -> int:
    """Each Gateway Key matching `text`, by its `admin keys --addresses` lines; a Hosted Household's key, named
    by its label, also by that Household's `admin households` lines."""
    relay, keys = _keys(paths, fetch)
    # What matched the text the maintainer typed, addresses and all (#781).
    printed = relay.print_keys(keys, paths.relay_state, today=today, find=text, addresses=True)
    hosted = [name for name in printed if LABEL.fullmatch(name)]
    if hosted:
        code, out = run(_as_service(paths, [], "signup", "status"), _clean_env())
        for label in hosted:
            lines = _household_lines(out, label)
            if lines:
                print("\n".join(lines))
            else:
                # Not its output, as for the nightly check.
                print(f"{label}: signup status (exit {code}) has no line for it", file=sys.stderr)
    return len(printed)


def _household_lines(out: str, label: str) -> list[str]:
    """The lines `signup status` printed for the Household `label`: its own and its doctor's."""
    return _status_lines(out, lambda said: LABEL.search(said).group() == label)


def _find_households(paths: Paths, address: str) -> int:
    """Prints each Household whose Recipients include `address`, by its label and its Invite
    Link's note, and nothing else of its config; returns how many it printed."""
    want = address.strip().lower()
    configs = _configs(paths)
    if not configs:
        return 0
    if not Path(paths.python).exists():
        sys.exit(f"{paths.python} is missing: the shared program isn't installed")
    failed = f"couldn't read the Households' configs with {paths.python}"
    try:
        read = subprocess.run([paths.python, "-I", "-c", READ_RECIPIENTS, *map(str, configs)],
                              capture_output=True, text=True, cwd="/", timeout=60)
    except subprocess.TimeoutExpired:
        sys.exit(f"{failed}: it took over a minute")
    try:
        recipients = json.loads(read.stdout)
    except ValueError:
        # Its last line says why, such as a missing module; it never quotes a config.
        sys.exit(f"{failed}: {(read.stderr.strip().splitlines() or ['no answer'])[-1]}")
    notes = _notes(paths.store / "households.json")
    found = 0
    for config in configs:
        label = config.parent.parent.name
        addresses = recipients.get(str(config))
        if addresses is None:
            print(f"{label}: its config couldn't be read", file=sys.stderr)
            continue
        if any(isinstance(a, str) and a.strip().lower() == want for a in addresses):
            found += 1
            print(f"{label} ({notes[label]})" if notes.get(label) else label)
    return found


def _configs(paths: Paths) -> list[Path]:
    """Each Household's config. A Household's user can replace its config or its `.family`
    with a link, so root follows no link in any part of the path: its home, `.family` or the
    config."""
    if not paths.homes.is_dir():
        return []
    configs = []
    for home in sorted(paths.homes.glob("ph-*")):
        config = home / ".family" / "config.yaml"
        if LABEL.fullmatch(home.name) and not any(
                p.is_symlink() for p in (home, config.parent, config)) and config.is_file():
            configs.append(config)
    return configs


