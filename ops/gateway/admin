SERVICES = ("bifrost", "brief-relay", "parent-recap-signup")
TIMERS = tuple(job.replace(".service", ".timer") for job in JOBS)
ROLLBACK_USAGE = "rollback [--restore]"


def _stack(paths: Paths) -> list[dict]:
    """What ran, in turn, by the record: a deploy goes on top, unless it is the commit on top
    already (then it only replaces a failed one), and a rollback takes the top one off. Its last
    is what runs, or what failed to install over the one before it; the one before it is what
    `rollback` switches back to."""
    stack: list[dict] = []
    for d in _deploys(paths):
        commit = str(d.get("commit", ""))
        if not COMMIT.fullmatch(commit):
            continue
        if d.get("rolled_back_from"):
            if stack and stack[-1]["commit"] == d["rolled_back_from"]:
                stack.pop()
            if stack and stack[-1]["commit"] == commit:
                continue
        elif stack and stack[-1]["commit"] == commit:
            if stack[-1].get("failed"):
                stack[-1] = d
            continue
        stack.append(d)
    return stack


def _on_disk(paths: Paths, short: str) -> bool:
    """Whether a deploy's checkout is still there; its program, if gone, is installed again."""
    return (paths.sources / short / "ops" / "gateway" / "gateway-setup.sh").is_file()


def _what(deploy: dict) -> str:
    failed = ", its install failed" if deploy.get("failed") else ""
    return f"{str(deploy.get('commit'))[:SHORT]} ({deploy.get('tag')}{failed})"


def _rollback_pair(paths: Paths, current: str | None) -> tuple[dict, dict] | None:
    """The deploy `rollback` leaves and the one it switches back to, by the record: the one on
    top must be what runs, or have failed to install over what runs."""
    stack = _stack(paths)
    if len(stack) < 2:
        return None
    runs = {stack[-1]["commit"][:SHORT]}
    if stack[-1].get("failed"):
        runs.add(stack[-2]["commit"][:SHORT])
    return (stack[-1], stack[-2]) if current in runs else None


def _list_deploys(paths: Paths) -> int:
    """Each deploy whose checkout is on disk, the last deployed first, with its record."""
    current = _current(paths)
    folders = sorted(p.name for p in paths.sources.iterdir()
                     if re.fullmatch(f"[0-9a-f]{{{SHORT}}}", p.name)) \
        if paths.sources.is_dir() else []
    last: dict[str, dict] = {}
    for d in _deploys(paths):
        last[str(d.get("commit", ""))[:SHORT]] = d
    pair = _rollback_pair(paths, current)
    back = pair[1]["commit"][:SHORT] if pair else None
    snapshots = {p.name for p in _snapshots(paths)}
    if not folders:
        print("no deploy on disk: the first is sudo admin deploy vX.Y.Z", file=sys.stderr)
        print(_running_deploy(paths))
        return 1
    print("deploys on disk, the last deployed first (* runs now):")
    for short in sorted(folders, key=lambda s: str(last.get(s, {}).get("at", "")), reverse=True):
        d = last.get(short)
        line = f"{'*' if short == current else ' '} {short}"
        if d is None:
            line += "  not recorded"
        else:
            line += f"  {d.get('tag')}, {_when(d)}"
        if not (paths.shared / short).is_dir():
            line += f", its program is gone from {paths.shared}"
        if short == back:
            line += "  <- sudo admin rollback switches to this"
        print(line)
    if current not in folders:
        print(_running_deploy(paths))
    mine = pair[0].get("snapshot") if pair else None
    print(f"snapshots in {paths.snapshots}, the last {KEEP_SNAPSHOTS} kept: "
          + (", ".join(sorted(snapshots, reverse=True)) or "none"))
    if mine in snapshots:
        print(f"sudo admin rollback --restore brings back {mine}, taken before "
              f"{pair[0]['commit'][:SHORT]}")
    return 0


def _rollback_target(paths: Paths) -> tuple[dict, dict]:
    """The deploy that runs and the one before it, whose checkout must still be on disk."""
    current = _current(paths)
    pair = _rollback_pair(paths, current)
    if pair is None:
        stack = _stack(paths)
        if current is None:
            raise Refused("the shared program isn't installed: there is nothing to switch back "
                          "from")
        if stack and stack[-1]["commit"][:SHORT] == current:
            raise Refused(f"{_what(stack[-1])} is the first deploy recorded: there is nothing "
                          "to switch back to")
        raise Refused(f"the server runs {current}, which isn't the last deploy recorded in "
                      f"{paths.record}: there is no deploy before it to switch back to. Deploy "
                      "the one you want with sudo admin deploy")
    leaving, back = pair
    if not _on_disk(paths, back["commit"][:SHORT]):
        raise Refused(f"the deploy before, {_what(back)}, is no longer on disk: deploy it again "
                      f"with sudo admin deploy {back['commit']}")
    return leaving, back


def _rollback(paths: Paths, args: list[str], edge: Edge) -> int:
    restore = "--restore" in args
    if [a for a in args if a != "--restore"]:
        raise Usage(ROLLBACK_USAGE)
    try:
        host = _env(paths.signup_env).get("GATEWAY_HOST")
        if not host:
            raise Refused(f"GATEWAY_HOST is missing from {paths.signup_env}")
        leaving, back = _rollback_target(paths)
        snapshot = _snapshot_before(paths, leaving) if restore else None
        households = _households(paths)
        # `current` must not change beneath a running evening run, nor its data be restored.
        _none_running(households, edge, "Switch back")
    except Refused as e:
        print(f"not switched back, nothing changed: {e}", file=sys.stderr)
        return 1
    if snapshot and not _confirmed(leaving, back, snapshot, edge):
        print("not switched back, nothing changed", file=sys.stderr)
        return 1

    if snapshot is None:
        switched = _switch(paths, host, leaving, back, edge)
    else:
        timers: list[tuple[str, str]] = []
        switched = False
        try:
            print("stopping " + ", ".join(SERVICES) + " and the Households' evening timers",
                  flush=True)
            timers = _stop_timers(households, edge)
            if not _stop_services(edge):
                print("❌ not every service stopped (above), so nothing was restored or switched "
                      "back", file=sys.stderr)
            elif _restored(paths, snapshot, edge):
                switched = _switch(paths, host, leaving, back, edge)
                if not switched:
                    print(f"❌ the state from {snapshot.name} is restored, but the program is "
                          f"still {_what(leaving)}'s: run sudo admin rollback again, without "
                          "--restore, once what failed (above) is fixed", file=sys.stderr)
        finally:
            # gateway-setup.sh starts the services itself when it ran.
            if not switched:
                _start_services(edge)
            _start_timers(timers, edge)
    if not switched:
        return 1
    print(f"switched back from {_what(leaving)} to {_what(back)}: {_running_deploy(paths)}",
          flush=True)
    if not _healthy(host, edge):
        print("\n❌ switched back, but a check failed (above)", file=sys.stderr)
        return 1
    print("\n✅ switched back. Read the Households' next evening runs: sudo admin households")
    return 0


def _snapshot_before(paths: Paths, deploy: dict) -> Path:
    name = str(deploy.get("snapshot") or "")
    snapshot = paths.snapshots / name
    if SNAPSHOT_NAME.fullmatch(name) and snapshot.is_file():
        return snapshot
    raise Refused(f"the snapshot taken before {_what(deploy)} "
                  + (f"({name}) isn't on disk any more" if name else
                     "wasn't taken: it was deployed before snapshots were")
                  + ". sudo admin rollback without --restore switches back the program alone")


def _confirmed(leaving: dict, back: dict, snapshot: Path, edge: Edge) -> bool:
    print(f"this switches the server back from {_what(leaving)} to {_what(back)} and brings back "
          f"the state from {snapshot.name}: Bifrost's, the Brief relay's and the sign-up "
          "service's, their config, and each Household's home whose user still holds the uid it "
          "had (not a removed one's). What changed since is lost: "
          "Households that signed up since lose their line in households.json, and Briefs "
          "archived and keys made since are gone.", flush=True)
    try:
        return edge.ask("Type yes to go on: ").strip().lower() == "yes"
    except EOFError:
        return False


def _restored(paths: Paths, snapshot: Path, edge: Edge) -> bool:
    try:
        put_back, left = _restore(snapshot, _home_kept_out(paths, edge))
    except (OSError, tarfile.TarError, ValueError, KeyError) as e:
        print(f"❌ restoring {snapshot.name} failed: {e}. The folder it was at is as it was, and "
              "those before it are restored; not switched back. Run it again once that is "
              "fixed", file=sys.stderr)
        return False
    print(f"restored {snapshot.name}: " + ", ".join(map(str, put_back)), flush=True)
    for root, reason in left:
        print(f"⚠️ {root.name}'s home isn't restored: {reason}", flush=True)
    kept = sorted(set(_state_roots(paths)) - set(put_back) - {root for root, _ in left})
    if kept:
        print("⚠️ not in the snapshot, so kept as they are: " + ", ".join(map(str, kept)),
              flush=True)
    return True


def _switch(paths: Paths, host: str, leaving: dict, back: dict, edge: Edge) -> bool:
    """Runs the deploy before's own gateway-setup.sh, its program kept as installed, and
    records the switch."""
    short = back["commit"][:SHORT]
    source = paths.sources / short
    print(f"switching back from {_what(leaving)} to {_what(back)}: running its gateway-setup.sh",
          flush=True)
    setup = edge.system(["bash", str(source / "ops" / "gateway" / "gateway-setup.sh")],
                        env={"GATEWAY_HOST": host, "PARENT_RECAP_RELEASE": str(source),
                             "PARENT_RECAP_DEPLOY": short, "PARENT_RECAP_SWITCH": "yes"})
    if setup.returncode != 0:
        print(f"❌ gateway-setup.sh of {short} failed (above). {_running_deploy(paths)}",
              file=sys.stderr)
        return False
    _record(paths, {"commit": back["commit"], "tag": back.get("tag"), "at": _stamp(edge),
                    "rolled_back_from": leaving["commit"]})
    return True


def _user_systemctl(edge: Edge, user: str, *args: str) -> subprocess.CompletedProcess:
    return edge.system(["systemctl", "--user", "-M", f"{user}@", *args])


def _stop_timers(households: list[tuple[str, str]], edge: Edge) -> list[tuple[str, str]]:
    """Stops each Household's active evening timers, so no run writes what the restore puts
    back. Returns them, to start again."""
    stopped = []
    for user, _ in households:
        for timer in TIMERS:
            if _unit(edge, user, timer).get("ActiveState") == "active":
                _user_systemctl(edge, user, "stop", timer)
                stopped.append((user, timer))
    return stopped


def _start_timers(stopped: list[tuple[str, str]], edge: Edge) -> None:
    """Starts again the timers _stop_timers stopped, each from its unit file as restored."""
    for user in dict.fromkeys(user for user, _ in stopped):
        _user_systemctl(edge, user, "daemon-reload")
    failed = [f"{user}'s {timer}" for user, timer in stopped
              if _user_systemctl(edge, user, "start", timer).returncode]
    if failed:
        print("⚠️ couldn't start again: " + ", ".join(failed), file=sys.stderr)


def _healthy(host: str, edge: Edge) -> bool:
    ok = True
    for name, port in HEALTH:
        status = edge.http_status(f"http://127.0.0.1:{port}/health")
        print(f"{'✅' if status == 200 else '❌'} {name} on /health: "
              f"{status or 'no answer'}", flush=True)
        ok = ok and status == 200
    status = edge.http_status(f"https://{host}/")
    print(f"{'✅' if status == 404 else '❌'} https://{host}/ outside its routes: "
          f"{status or 'no answer'} (404 expected)", flush=True)
    return ok and status == 404


def _no_check() -> bool:
    print("no Household yet, so no evening run checked this deploy")
    return True


def _evening_run(paths: Paths, user: str, edge: Edge) -> bool:
    """Runs `user`'s evening run as its timer would, waits for it to end and says how."""
    before = _unit(edge, user, EVENING_JOB).get("ExecMainStartTimestampMonotonic", "")
    print(f"running {user}'s evening run, which sends its Brief to its Recipients...", flush=True)
    started = edge.system(["sudo", "-u", user, "-H", "--", paths.program, "schedule", "run-now"])
    if started.returncode != 0:
        print(f"❌ {user}'s evening run didn't start (above)", flush=True)
        return False
    deadline = edge.monotonic() + CHECK_MINUTES * 60
    while True:
        unit = _unit(edge, user, EVENING_JOB)
        began = unit.get("ExecMainStartTimestampMonotonic", "")
        if began not in ("", "0", before) and unit.get("ActiveState") in ("inactive", "failed"):
            break
        if edge.monotonic() >= deadline:
            print(f"⚠️ {user}'s evening run hasn't ended after {CHECK_MINUTES} minutes: read "
                  "sudo admin households once it has", flush=True)
            return False
        edge.sleep(5)
    if unit.get("Result") == "success":
        print(f"✅ {user}'s evening run ended ok", flush=True)
        return True
    print(f"❌ {user}'s evening run failed ({unit.get('Result')}, exit "
          f"{unit.get('ExecMainStatus')}): its log is ~{user}/ParentRecap/logs/run-stderr.log",
          flush=True)
    return False


def _notes(path: Path) -> dict[str, str]:
    try:
        return {str(h["user"]): str(h.get("note") or "")
                for h in json.loads(path.read_text(encoding="utf-8"))}
    except (OSError, ValueError, TypeError, KeyError):
        return {}


def _keys(paths: Paths, fetch: Callable[..., dict] | None) -> tuple[Any, Any]:
    """The Brief relay's module, and Bifrost's admin API with the admin login."""
    login = _admin_login(paths)
    relay = _relay(paths)
    return relay, relay.Bifrost(paths.bifrost_url, login[ADMIN_LOGIN[0]], login[ADMIN_LOGIN[1]],
                                fetch=fetch)


def _relay(paths: Paths) -> Any:
    """The Brief relay's module, as gateway-setup.sh installs it."""
    relay = sys.modules.get("brief_relay")
    if relay is None:
        spec = importlib.util.spec_from_file_location("brief_relay", paths.relay)
        if spec is None or not paths.relay.exists():
            sys.exit(f"{paths.relay} is missing: run gateway-setup.sh")
        relay = sys.modules["brief_relay"] = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(relay)
    return relay


# ── The nightly check (#745)

def _check(paths: Paths, run: Callable[[list[str], dict], tuple[int, str]], mail: bool,
           smtp: Callable[..., Any] | None, today: str) -> int:
    """Prints what is wrong, or that nothing is; with `mail`, mails it to the maintainers when
    something is, and fails only when that mail couldn't go. Without, 1 when something is."""
    found = _problems(paths, run)
    if not found:
        print("nothing wrong")
        return 0
    host = _env(paths.signup_env).get("GATEWAY_HOST")
    text = (f"The nightly check{f' on {host}' if host else ''} found:\n\n"
            + "\n\n".join(found)
            + "\n\nSSH in and run sudo admin households for every Household's status; "
              'ops/gateway/README.md "The nightly check" says what each means.\n')
    print(text, end="")
    if not mail:
        return 1
    _mail(paths, f"Parent Recap server: something is wrong ({today})", text, smtp)
    return 0


def _signed_up(paths: Paths, label: str, smtp: Callable[..., Any] | None) -> int:
    """Mails the maintainers that the sign-up made Household `label` (#814): its label, its note
    in households.json, the Invite Link's with the name the family gave, and the time its Brief
    comes, Helsinki's as the sign-up hands the slots out. Nothing else of the Household."""
    try:
        evening = dict(_households(paths)).get(label)
    except Refused as e:
        sys.exit(f"{e}, so nobody was mailed")
    if evening is None:
        sys.exit(f"{label} isn't in {paths.store / 'households.json'}, so nobody was mailed")
    note = _notes(paths.store / "households.json").get(label, "")
    host = _env(paths.signup_env).get("GATEWAY_HOST")
    text = (f"A Household signed up{f' on {host}' if host else ''}:\n\n"
            f"{f'{label} ({note})' if note else label}\n"
            f"Its Brief comes each evening at {evening}, Helsinki time.\n\n"
            "SSH in and run sudo admin households for its status.\n")
    _mail(paths, f"Parent Recap: a new Household, {label}", text, smtp)
    return 0


def _problems(paths: Paths, run: Callable[[list[str], dict], tuple[int, str]]) -> list[str]:
    """What is wrong, one paragraph each: the Households marked, the services down, a reboot."""
    found = []
    enabled = [u for u in CHECKED if run(["systemctl", "is-enabled", "--quiet", u], {})[0] == 0]
    if SERVICE in enabled:
        code, out = run(_as_service(paths, [], "signup", "status"), _clean_env())
        marked = _marked(out)
        if code == 1 and marked:
            found.append("Households marked in their status:\n" + "\n".join(marked))
        elif code != 0:
            # Not its output, which says nothing private but isn't the status either.
            found.append(f"The Households' status couldn't be read: signup status ended with "
                         f"{code}.")
    down = [u for u in enabled if run(["systemctl", "is-active", "--quiet", u], {})[0] != 0]
    if down:
        found.append(f"Not running: {', '.join(down)} (systemctl status {' '.join(down)}).")
    if paths.reboot_required.exists():
        # As `signup status` says it (REBOOT_PENDING in family_brief/signup/status.py).
        found.append("Reboot pending: the server waits for a reboot to apply updates")
    return found


def _marked(out: str) -> list[str]:
    """The lines of each Household `signup status` marked ❌, ⚠️ or ❓: its own and its doctor's."""
    return _status_lines(out, lambda said: not said.startswith("✅"))


def _status_lines(out: str, wanted: Callable[[str], bool]) -> list[str]:
    """The lines of each Household in `signup status`'s output whose own line is `wanted`: that
    line and the indented ones under it, its doctor's."""
    kept, keep = [], False
    for said in out.splitlines():
        if HOUSEHOLD_LINE.match(said):
            keep = wanted(said)
        elif not said.startswith("   "):
            keep = False
        if keep:
            kept.append(said)
    return kept


def _mail(paths: Paths, subject: str, text: str, smtp: Callable[..., Any] | None) -> None:
    """Sends `text` to the maintainers from the Brief's address, as the relay sends, counted in
    the relay's day of Email Delivery's quota."""
    relay = _relay(paths)
    to = [a.strip() for a in _env(paths.maintainers_env).get("MAINTAINERS_ADDRESS", "").split(",")
          if a.strip()]
    if not to:
        sys.exit(f"no MAINTAINERS_ADDRESS in {paths.maintainers_env}, so nobody was mailed: run "
                 "gateway-setup.sh with MAINTAINERS_ADDRESS=<address>")
    if not all(relay.ADDRESS.fullmatch(a) for a in to):
        sys.exit(f"MAINTAINERS_ADDRESS in {paths.maintainers_env} must be plain name@domain "
                 "addresses, separated by commas")
    login = _env(paths.smtp_env)
    if not (login.get("BRIEF_SMTP_USERNAME") and login.get("BRIEF_SMTP_PASSWORD")):
        sys.exit(f"{paths.smtp_env} has no SMTP credentials: run set-smtp-credentials.sh")
    msg = EmailMessage()
    msg["From"] = relay.FROM
    msg["To"] = ", ".join(to)
    msg["Subject"] = subject
    msg["Date"] = formatdate(usegmt=True)
    msg["Message-ID"] = make_msgid(domain=relay.FROM_ADDR.split("@")[1])
    msg.set_content(text)
    quota = paths.relay_state / "quota.json"
    mailer = relay.Mailer(login.get("BRIEF_SMTP_HOST") or relay.SMTP_HOST, 465,
                          login["BRIEF_SMTP_USERNAME"], login["BRIEF_SMTP_PASSWORD"],
                          quota=relay.Quota(quota), **({"smtp": smtp} if smtp else {}))
    try:
        refused = mailer.send(msg, to)
    except relay.Refused as e:
        sys.exit(f"the mail wasn't sent: {e.reason}")
    # Written as root: given back to the relay's user, whose directory it is.
    # The server is Linux; Windows, where the tests also run, has no chown.
    chown = getattr(os, "chown", None)
    try:
        owner = paths.relay_state.stat()
        if chown:
            chown(quota, owner.st_uid, owner.st_gid)
    except OSError:
        pass
    sent = len(to) - refused
    print(f"mailed to {sent} maintainer address{'' if sent == 1 else 'es'}"
          + (f"; Email Delivery refused {refused}" if refused else ""))


def _run(argv: list[str], env: dict) -> tuple[int, str]:
    """Its exit and output; what it says on stderr isn't kept."""
    r = subprocess.run(argv, env=env or None, capture_output=True, text=True, cwd="/")
    return r.returncode, r.stdout


def _today() -> str:
    """Today's UTC day, as the relay and Bifrost's daily budgets count days."""
    return datetime.now(UTC).date().isoformat()


def _admin_login(paths: Paths) -> dict[str, str]:
    """Bifrost's admin login from bifrost.env; the provider key in the same file is not kept."""
    if not paths.bifrost_env.exists():
        sys.exit(f"{paths.bifrost_env} is missing: run gateway-setup.sh first")
    env = _env(paths.bifrost_env)
    login = {name: env.get(name, "") for name in ADMIN_LOGIN}
    if not all(login.values()):
        sys.exit(f"{paths.bifrost_env} has no admin login: run gateway-setup.sh first")
    return login


def _env(path: Path) -> dict[str, str]:
    """NAME=value lines, as gateway-setup.sh writes them; a missing file has none."""
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return {}
    return {name: value for name, sep, value in (line.partition("=") for line in lines)
            if sep and not name.startswith("#")}


def _as_service(paths: Paths, sudo_options: list[str], *program_args: str) -> list[str]:
    return ["sudo", *sudo_options, "-u", SERVICE, "-H", "--", paths.program, *program_args]


def _clean_env() -> dict[str, str]:
    return {k: v for k, v in os.environ.items() if k not in ADMIN_LOGIN}


def _exec(argv: list[str], env: dict) -> NoReturn:
    # From /, as the old scripts did: the service's user can't read a maintainer's folder.
    os.chdir("/")
    os.execvpe(argv[0], argv, env)


