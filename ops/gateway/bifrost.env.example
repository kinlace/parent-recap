# Copy to /etc/bifrost/bifrost.env (root, mode 0600). gateway-setup.sh asks for these.
ANTHROPIC_API_KEY=
BIFROST_ADMIN_USERNAME=
BIFROST_ADMIN_PASSWORD=
# The sending domain's SMTP credentials (README "The sending domain"); set-smtp-credentials.sh writes them.
BRIEF_SMTP_USERNAME=
BRIEF_SMTP_PASSWORD=
